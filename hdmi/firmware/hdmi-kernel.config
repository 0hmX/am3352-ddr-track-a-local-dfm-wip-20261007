# Merge with the real AM3352 board defconfig; this is a display-only fragment.
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_TILCDC=y
CONFIG_DRM_ITE_IT66121=y
CONFIG_DRM_DISPLAY_CONNECTOR=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_I2C=y
CONFIG_I2C_OMAP=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_OMAP=y
CONFIG_PINCTRL_SINGLE=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
# CONFIG_FB_DA8XX is not set
# CONFIG_FB_DA8XX_TDA998X is not set
# No simple-audio-card node or HDMI audio oscillator in this board revision.
